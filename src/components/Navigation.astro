---
const base = import.meta.env.BASE_URL;
const makeHref = (path) => {
  const normalizedBase = base.endsWith('/') ? base.slice(0, -1) : base;
  const normalizedPath = path.startsWith('/') ? path : `/${path}`;
  return `${normalizedBase}${normalizedPath}`;
};

const navItems = [
  { label: "Home", href: makeHref("/") },
  { label: "About", href: makeHref("/#about") },
  { label: "Projects", href: makeHref("/#projects") },
  { label: "Skills", href: makeHref("/#skills") },
  { label: "Contact", href: makeHref("/#contact") },
  { label: "Components", href: makeHref("/components") },
];
---

<nav aria-label="Main navigation" class="fixed top-0 left-0 right-0 z-50 bg-gradient-to-b from-[#2a2b2c] to-[#111] border-b border-black shadow-[0_10px_30px_rgba(0,0,0,0.8),inset_0_1px_0_rgba(255,255,255,0.1)]">
  <!-- Rack Mount Screws -->
  <div class="absolute left-4 md:left-8 top-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-zinc-600 shadow-[inset_1px_1px_3px_rgba(0,0,0,0.8),0_1px_0_rgba(255,255,255,0.1)] items-center justify-center hidden sm:flex"><div class="w-full h-[1px] bg-black/60 rotate-45"></div></div>
  <div class="absolute right-4 md:right-8 top-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-zinc-600 shadow-[inset_1px_1px_3px_rgba(0,0,0,0.8),0_1px_0_rgba(255,255,255,0.1)] items-center justify-center hidden sm:flex"><div class="w-full h-[1px] bg-black/60 -rotate-12"></div></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-12">
    <div class="flex items-center justify-between h-16 relative">
      <!-- Logo -->
      <a href={makeHref("/")} class="flex items-center gap-2 group" aria-label="Alex Morgan - Home">
        <div
          class="w-10 h-10 rounded-xl shadow-premium-raised flex items-center justify-center bg-matte-plastic border border-gray-600 text-gray-200 font-bold text-lg group-hover:brightness-110 transition-all duration-200"
          aria-hidden="true"
        >
          AM
        </div>
        <span class="font-display font-bold text-xl text-gray-200 text-etched-inset hidden sm:inline">
          Alex Morgan
        </span>
      </a>

      <!-- Navigation Links -->
      <ul class="flex items-center gap-1 md:gap-2" role="list">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="px-3 md:px-4 py-2 rounded-lg text-gray-400 hover:text-gray-200 font-medium transition-all duration-200 hover:bg-[#111] hover:shadow-premium-inset border border-transparent hover:border-gray-700/50 text-sm md:text-base active:shadow-premium-pressed"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>
