---
import "../styles/global.css";
import { PowerSwitch } from "../components/skeuomorphic/PowerSwitch";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Alex Morgan - Portfolio",
  description = "Portfolio website",
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="antialiased font-sans bg-neubg text-gray-800 bg-noise relative min-h-screen">
    <PowerSwitch client:load />
    <slot />
  </body>
</html>
