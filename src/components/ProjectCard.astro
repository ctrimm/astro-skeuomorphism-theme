---
interface Props {
  title: string;
  description: string;
  techStack: string[];
  imageUrl: string;
  projectUrl: string;
}

const { title, description, techStack, imageUrl, projectUrl } = Astro.props;

// Deterministically select a flicker speed based on the title length
const flickerClasses = ['crt-animate', 'crt-animate-slow', 'crt-animate-fast'];
const flickerClass = flickerClasses[title.length % 3];
---

<article class="group relative bg-[#1c1d1e] rounded-2xl shadow-[0_15px_30px_rgba(0,0,0,0.6),inset_0_1px_0_rgba(255,255,255,0.05)] border border-black p-4 md:p-5 transition-all duration-300 hover:shadow-[0_20px_40px_rgba(0,0,0,0.8),0_10px_20px_rgba(0,0,0,0.6)] hover:-translate-y-2">
  <!-- Modular Rack Screws -->
  <div class="absolute top-4 left-4 w-2.5 h-2.5 rounded-full bg-zinc-500 shadow-[inset_1px_1px_3px_rgba(0,0,0,0.6),0_1px_0_rgba(255,255,255,0.1)] flex items-center justify-center -rotate-45 z-10"><div class="w-full h-[1px] bg-black/60"></div></div>
  <div class="absolute top-4 right-4 w-2.5 h-2.5 rounded-full bg-zinc-500 shadow-[inset_1px_1px_3px_rgba(0,0,0,0.6),0_1px_0_rgba(255,255,255,0.1)] flex items-center justify-center rotate-12 z-10"><div class="w-full h-[1px] bg-black/60"></div></div>
  <div class="absolute bottom-4 left-4 w-2.5 h-2.5 rounded-full bg-zinc-500 shadow-[inset_1px_1px_3px_rgba(0,0,0,0.6),0_1px_0_rgba(255,255,255,0.1)] flex items-center justify-center rotate-90 z-10"><div class="w-full h-[1px] bg-black/60"></div></div>
  <div class="absolute bottom-4 right-4 w-2.5 h-2.5 rounded-full bg-zinc-500 shadow-[inset_1px_1px_3px_rgba(0,0,0,0.6),0_1px_0_rgba(255,255,255,0.1)] flex items-center justify-center -rotate-12 z-10"><div class="w-full h-[1px] bg-black/60"></div></div>

  <!-- Inner Plate -->
  <div class="bg-gradient-to-b from-[#111] to-[#0a0a0a] rounded-xl overflow-hidden shadow-[inset_0_2px_10px_rgba(0,0,0,0.8)] border border-gray-800 relative w-full h-full flex flex-col">
    <!-- Image Screen -->
    <div class={`relative overflow-hidden aspect-video bg-[#050505] shadow-[inset_0_5px_15px_rgba(0,0,0,1)] border-b border-white/5 m-3 rounded-lg flex-shrink-0 crt ${flickerClass}`}>
      <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/5 to-white/10 pointer-events-none z-30"></div>
      <img src={imageUrl} alt={title} class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500 opacity-80 mix-blend-screen sepia-[0.3] hue-rotate-[190deg]" loading="lazy" />
      
      <!-- Video Overlays -->
      <div class="absolute bottom-2 left-2 flex gap-1.5 items-center z-30 bg-black/50 px-2 py-0.5 rounded border border-white/10">
         <div class="w-1.5 h-1.5 rounded-full bg-red-500 shadow-[0_0_8px_#ef4444] animate-pulse"></div>
         <span class="text-[8px] font-mono text-red-400 uppercase tracking-widest">Rec</span>
      </div>
      <div class="absolute top-2 right-2 z-30">
         <span class="text-[8px] font-mono text-green-500/70 tracking-widest drop-shadow-[0_0_2px_rgba(34,197,94,0.5)]">CH_01</span>
      </div>
    </div>

    <!-- Content -->
    <div class="p-5 flex-1 flex flex-col justify-between relative z-10">
      <div>
        <h3 class="text-xl font-bold text-gray-200 text-etched-inset mb-3 font-mono uppercase tracking-wide border-b border-gray-800 pb-2">{title}</h3>
        <p class="text-sm text-gray-400 mb-5 font-mono leading-relaxed">{description}</p>
      </div>

      <div class="space-y-5">
        <!-- Tech Stack LCD -->
        <div class="bg-[#050505] border border-gray-800 rounded p-2 shadow-[inset_0_2px_5px_rgba(0,0,0,1)] flex flex-wrap gap-1.5">
          {techStack.map((tech) => (
             <span class="px-1.5 py-0.5 text-[9px] font-mono bg-green-950/30 text-green-400 drop-shadow-[0_0_2px_rgba(74,222,128,0.6)] uppercase tracking-wider border border-green-900/50 rounded-sm">
               {tech}
             </span>
          ))}
        </div>

        <!-- Execute Button -->
        <div class="flex justify-end">
          <a href={projectUrl} target="_blank" rel="noopener noreferrer" class="group/btn relative inline-flex items-center justify-center px-4 py-2 bg-gradient-to-b from-gray-700 to-gray-900 border border-black rounded shadow-[inset_0_1px_0_rgba(255,255,255,0.2),0_4px_6px_rgba(0,0,0,0.5)] active:translate-y-[2px] active:shadow-[inset_0_2px_4px_rgba(0,0,0,0.8),0_0_0_rgba(0,0,0,0)] transition-all">
            <span class="text-[10px] font-mono font-bold text-gray-300 group-active/btn:text-blue-400 transition-colors uppercase tracking-widest flex items-center gap-2 drop-shadow-[0_1px_1px_rgba(0,0,0,0.8)]">
              <span class="w-1.5 h-1.5 rounded-full bg-[#111] shadow-[inset_0_1px_1px_rgba(0,0,0,1)] flex-shrink-0 group-active/btn:bg-blue-500 group-active/btn:shadow-[0_0_6px_#3b82f6]"></span>
              Init_Seq
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</article>
