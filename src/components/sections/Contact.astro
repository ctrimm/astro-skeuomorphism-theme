---
import { NeuCard } from "../skeuomorphic/NeuCard";
import { SkeuoButton } from "../skeuomorphic/Button";

const socialLinks = [
  { name: "GitHub", url: "https://github.com", icon: "github" },
  { name: "LinkedIn", url: "https://linkedin.com", icon: "linkedin" },
  { name: "Twitter", url: "https://twitter.com", icon: "twitter" },
];
---

<section id="contact" class="min-h-screen py-20 px-4 bg-[#0a0a0a] relative overflow-hidden">
  <div class="absolute inset-0 bg-brushed-metal opacity-5 pointer-events-none"></div>

  <div class="max-w-4xl mx-auto relative z-10">
    <h2
      class="text-4xl md:text-5xl font-display font-bold text-center mb-4 text-gray-200 text-etched-inset"
    >
      Get In Touch
    </h2>
    <div
      class="w-24 h-1 bg-gradient-to-r from-blue-400 to-purple-500 mx-auto mb-4 rounded-full shadow-[0_0_8px_rgba(59,130,246,0.6)]"
    >
    </div>
    <p class="text-center text-gray-400 mb-12 max-w-2xl mx-auto">
      Have a project in mind or just want to chat? I'd love to hear from you.
      Drop me a message and I'll get back to you as soon as possible.
    </p>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Contact Form Module -->
      <div class="relative bg-[#1c1d1e] rounded-xl p-6 md:p-8 shadow-[0_15px_30px_rgba(0,0,0,0.6),inset_0_1px_0_rgba(255,255,255,0.05)] border border-black overflow-hidden">
        <div class="absolute inset-0 bg-noise opacity-20 pointer-events-none mix-blend-overlay"></div>
        
        <!-- Module Screws -->
        <div class="absolute top-4 left-4 w-2 h-2 rounded-full bg-zinc-500 shadow-[inset_1px_1px_2px_rgba(0,0,0,0.6),0_1px_0_rgba(255,255,255,0.1)] -rotate-12"><div class="w-full h-[1px] bg-black/60"></div></div>
        <div class="absolute top-4 right-4 w-2 h-2 rounded-full bg-zinc-500 shadow-[inset_1px_1px_2px_rgba(0,0,0,0.6),0_1px_0_rgba(255,255,255,0.1)] rotate-45"><div class="w-full h-[1px] bg-black/60"></div></div>
        <div class="absolute bottom-4 left-4 w-2 h-2 rounded-full bg-zinc-500 shadow-[inset_1px_1px_2px_rgba(0,0,0,0.6),0_1px_0_rgba(255,255,255,0.1)] rotate-90"><div class="w-full h-[1px] bg-black/60"></div></div>
        <div class="absolute bottom-4 right-4 w-2 h-2 rounded-full bg-zinc-500 shadow-[inset_1px_1px_2px_rgba(0,0,0,0.6),0_1px_0_rgba(255,255,255,0.1)] rotate-180"><div class="w-full h-[1px] bg-black/60"></div></div>

        <div class="relative z-10 px-2 mt-2">
          <div class="flex items-center justify-between mb-8 border-b border-gray-700/50 pb-4">
            <h3 class="text-xl font-bold text-gray-300 text-etched-inset font-mono tracking-widest uppercase">Input_Terminal</h3>
            <div class="w-2 h-2 rounded-full bg-yellow-500 shadow-[0_0_8px_#eab308,inset_0_1px_2px_rgba(0,0,0,0.5)] border border-black animate-pulse"></div>
          </div>

          <form class="space-y-6" aria-label="Contact form">
            <div>
              <label for="name" class="block text-xs font-mono font-medium text-gray-500 mb-2 uppercase tracking-wider">
                User_Name <span class="text-red-500 drop-shadow-[0_0_4px_rgba(239,68,68,0.8)]" aria-label="required">*</span>
              </label>
              <div class="relative bg-[#050505] rounded shadow-[inset_0_4px_10px_rgba(0,0,0,1)] border border-gray-800 p-1">
                <div class="absolute inset-0 bg-gradient-to-b from-white/5 to-transparent pointer-events-none z-20"></div>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  aria-required="true"
                  class="w-full bg-transparent border-none focus:outline-none focus:ring-0 text-green-400 font-mono text-sm px-3 py-2 z-10 relative drop-shadow-[0_0_2px_#4ade80]"
                  placeholder="> Enter Name_"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-xs font-mono font-medium text-gray-500 mb-2 uppercase tracking-wider">
                Comms_Link <span class="text-red-500 drop-shadow-[0_0_4px_rgba(239,68,68,0.8)]" aria-label="required">*</span>
              </label>
              <div class="relative bg-[#050505] rounded shadow-[inset_0_4px_10px_rgba(0,0,0,1)] border border-gray-800 p-1">
                <div class="absolute inset-0 bg-gradient-to-b from-white/5 to-transparent pointer-events-none z-20"></div>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  aria-required="true"
                  class="w-full bg-transparent border-none focus:outline-none focus:ring-0 text-green-400 font-mono text-sm px-3 py-2 z-10 relative drop-shadow-[0_0_2px_#4ade80]"
                  placeholder="> Enter Email_"
                />
              </div>
            </div>

            <div>
              <label for="message" class="block text-xs font-mono font-medium text-gray-500 mb-2 uppercase tracking-wider">
                Data_Payload <span class="text-red-500 drop-shadow-[0_0_4px_rgba(239,68,68,0.8)]" aria-label="required">*</span>
              </label>
              <div class="relative bg-[#050505] rounded shadow-[inset_0_4px_10px_rgba(0,0,0,1)] border border-gray-800 p-1">
                <div class="absolute inset-0 bg-gradient-to-b from-white/5 to-transparent pointer-events-none z-20"></div>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  required
                  aria-required="true"
                  class="w-full bg-transparent border-none focus:outline-none focus:ring-0 text-green-400 font-mono text-sm px-3 py-2 z-10 relative drop-shadow-[0_0_2px_#4ade80] resize-none"
                  placeholder="> Write Message_"></textarea>
              </div>
            </div>

            <div class="pt-4 flex justify-end">
              <!-- Mega Submit Button -->
              <button type="submit" class="group relative px-6 py-3 bg-gradient-to-b from-red-600 to-red-900 border border-black rounded shadow-[inset_0_1px_0_rgba(255,255,255,0.3),0_6px_10px_rgba(0,0,0,0.6)] active:translate-y-[4px] active:shadow-[inset_0_3px_6px_rgba(0,0,0,0.8),0_0_0_rgba(0,0,0,0)] transition-all flex items-center gap-3 overflow-hidden cursor-pointer hover:brightness-110">
                <div class="absolute left-0 top-0 bottom-0 w-2 bg-gradient-to-b from-yellow-400 to-yellow-600 opacity-50 block repeating-linear-gradient-[45deg,transparent,transparent_2px,#000_2px,#000_4px]"></div>
                <span class="w-1.5 h-1.5 rounded-full bg-[#111] shadow-[inset_0_1px_1px_rgba(0,0,0,1)] group-active:bg-red-400 group-active:shadow-[0_0_10px_#f87171] ml-3 transition-colors"></span>
                <span class="text-sm font-mono font-bold text-gray-100 uppercase tracking-widest drop-shadow-[0_1px_1px_rgba(0,0,0,0.8)]">Transmit</span>
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Contact Info -->
      <div class="space-y-6">
        <!-- Contact Info Module -->
        <div class="relative bg-[#1c1d1e] rounded-xl p-6 shadow-[0_15px_30px_rgba(0,0,0,0.6),inset_0_1px_0_rgba(255,255,255,0.05)] border border-black overflow-hidden">
          <div class="absolute inset-0 bg-noise opacity-20 pointer-events-none mix-blend-overlay"></div>
          
          <div class="relative z-10 px-2 mt-1">
            <h3 class="text-xl font-bold text-gray-300 mb-6 text-etched-inset font-mono tracking-widest uppercase border-b border-gray-700/50 pb-3">
              Network_Config
            </h3>
            <div class="space-y-5">
              <div class="flex items-center gap-4 bg-[#111] p-3 rounded-lg border border-gray-800 shadow-[inset_0_2px_5px_rgba(0,0,0,0.8)]">
                <div class="w-10 h-10 rounded shadow-premium-raised border border-black flex items-center justify-center bg-gradient-to-b from-gray-700 to-gray-800 flex-shrink-0 relative overflow-hidden">
                  <div class="absolute inset-0 bg-noise opacity-30 mix-blend-overlay pointer-events-none"></div>
                  <svg class="w-5 h-5 text-blue-400 drop-shadow-[0_0_4px_rgba(96,165,250,0.6)] relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                </div>
                <div>
                  <p class="text-[9px] font-mono text-gray-500 uppercase tracking-widest mb-1">Email_Routing</p>
                  <a href="mailto:alex.morgan@example.com" class="font-mono text-sm text-gray-300 hover:text-blue-400 transition-colors drop-shadow-[0_1px_1px_rgba(0,0,0,0.8)]">
                    alex.morgan@example.com
                  </a>
                </div>
              </div>
              <div class="flex items-center gap-4 bg-[#111] p-3 rounded-lg border border-gray-800 shadow-[inset_0_2px_5px_rgba(0,0,0,0.8)]">
                <div class="w-10 h-10 rounded shadow-premium-raised border border-black flex items-center justify-center bg-gradient-to-b from-gray-700 to-gray-800 flex-shrink-0 relative overflow-hidden">
                  <div class="absolute inset-0 bg-noise opacity-30 mix-blend-overlay pointer-events-none"></div>
                  <svg class="w-5 h-5 text-green-400 drop-shadow-[0_0_4px_rgba(74,222,128,0.6)] relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                </div>
                <div>
                  <p class="text-[9px] font-mono text-gray-500 uppercase tracking-widest mb-1">Geoloc_Data</p>
                  <p class="font-mono text-sm text-gray-300 drop-shadow-[0_1px_1px_rgba(0,0,0,0.8)]">San Francisco, CA</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Social Links -->
        <div class="relative bg-[#1c1d1e] rounded-xl p-6 shadow-[0_15px_30px_rgba(0,0,0,0.6),inset_0_1px_0_rgba(255,255,255,0.05)] border border-black overflow-hidden">
          <div class="absolute inset-0 bg-noise opacity-20 pointer-events-none mix-blend-overlay"></div>
          <div class="relative z-10 px-2 mt-1">
            <h3 class="text-xl font-bold text-gray-300 mb-5 text-etched-inset font-mono tracking-widest uppercase border-b border-gray-700/50 pb-3">Ext_Links</h3>
            <div class="flex gap-4 p-2 bg-[#111] rounded-lg border border-gray-800 shadow-[inset_0_2px_5px_rgba(0,0,0,0.8)] justify-center">
              {socialLinks.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-12 h-12 rounded bg-gradient-to-b from-gray-700 to-gray-800 border border-black shadow-[inset_0_1px_0_rgba(255,255,255,0.2),0_4px_6px_rgba(0,0,0,0.5)] active:translate-y-[2px] active:shadow-[inset_0_2px_4px_rgba(0,0,0,0.8),0_0_0_rgba(0,0,0,0)] flex items-center justify-center text-gray-400 hover:text-blue-400 transition-all duration-150"
                  aria-label={link.name}
                >
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    {link.name === 'GitHub' && (
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                    )}
                    {link.name === 'LinkedIn' && (
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                    )}
                    {link.name === 'Twitter' && (
                      <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z" />
                    )}
                  </svg>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
